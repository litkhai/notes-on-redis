# Python / 파이썬
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Node (client labs) / 노드
node_modules/

# Environment — never commit API keys or Redis Cloud credentials
# 환경변수 — API 키·Redis Cloud 접속 정보가 들어가므로 절대 커밋하지 않는다
.env
.env.local
.env.bak
*.local

# Redis dumps and local data dirs created by labs
# 실습이 만드는 Redis 덤프와 로컬 데이터 디렉터리
dump.rdb
appendonly.aof
appendonlydir/
**/data/
*.rdb

# Terraform (Redis Cloud provider labs)
# state 파일에는 비밀값이 평문으로 남을 수 있다
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc

# Editors / OS / 에디터 · OS
.DS_Store
.idea/
.vscode/

# Jekyll / GitHub Pages
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock

# Lab artifacts / 실습 중 생성되는 산출물
*.log
outputs/

# Vercel local link and build cache
.vercel/
