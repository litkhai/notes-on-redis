---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%} Every content page; redirect stubs (layout: null) and 404 are left out (#64). {%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
{%- if p.layout == "default" and p.url != "/404.html" %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod></url>
{%- endif %}
{%- endfor %}
</urlset>
